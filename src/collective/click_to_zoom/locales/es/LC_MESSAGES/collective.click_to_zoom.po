#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:15
msgid "Check this to enable the click-to-zoom effect on images."
msgstr "Selecciona esto para activar el efecto click-to-zoom (ampliar) en las imágenes."

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:41
msgid "Click To Zoom Control Panel"
msgstr "Panel de control de Click To Zoom"

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:14
msgid "Enable Click to Zoom"
msgstr "Activar Click to Zoom"

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:30
msgid "If enabled, the zoom effect will show the original image instead of the selected scale."
msgstr "Si se activa, el efecto de zoom mostrará la imagen original en lugar de la escala seleccionada."

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:21
msgid "Image scale"
msgstr "Escala de la imagen"

#: collective/click_to_zoom/profiles.zcml:13
msgid "Package to configure a new collective.click_to_zoom site"
msgstr "Paquete para configurar un nuevo sitio con collective.click_to_zoom"

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:22
msgid "Select the image scale that will be loaded when zooming."
msgstr "Selecciona la escala (tamaño) de la imagen que se cargará al hacer zoom."

#: collective/click_to_zoom/controlpanels/click_to_zoom_control_panel/controlpanel.py:29
msgid "Show original image"
msgstr "Mostrar imagen original"

#: collective/click_to_zoom/profiles.zcml:21
msgid "Uninstall collective.click_to_zoom setup."
msgstr "Desinstalar la configuración de collective.click_to_zoom."

#: collective/click_to_zoom/profiles.zcml:13
msgid "collective.click_to_zoom: Install"
msgstr "collective.click_to_zoom: Instalar"

#: collective/click_to_zoom/profiles.zcml:21
msgid "collective.click_to_zoom: Uninstall"
msgstr "collective.click_to_zoom: Desinstalar"
