<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.click_to_zoom"
    >

  <browser:page
      name="click_to_zoom_control_panel-controlpanel"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.ClickToZoomControlPanelView"
      permission="cmf.ManagePortal"
      layer="collective.click_to_zoom.interfaces.IBrowserLayer"
      />

  <include package="plone.restapi" />
  <adapter
      factory=".controlpanel.ClickToZoomControlPanelConfigletPanel"
      name="click_to_zoom_control_panel"
      />


</configure>
